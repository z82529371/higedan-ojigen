{
  "id": "i-love",
  "title": "I LOVE...",
  "audio": "audio/i-love.m4a",
  "lyrics": [
    {
      "start": 25,
      "end": 27.61,
      "text": "僕が見つめる"
    },
    {
      "start": 27.61,
      "end": 30.45,
      "text": "景色のその中に"
    },
    {
      "start": 30.45,
      "end": 32.6,
      "text": "君が入ってから"
    },
    {
      "start": 32.6,
      "end": 35.98,
      "text": "変わり果てた世界は"
    },
    {
      "start": 35.98,
      "end": 38.67,
      "text": "いつもそつなく"
    },
    {
      "start": 38.67,
      "end": 41.49,
      "text": "こなした日々の真ん中"
    },
    {
      "start": 41.49,
      "end": 43.73,
      "text": "不思議な引力に"
    },
    {
      "start": 43.73,
      "end": 47.3,
      "text": "逆らえず崩れてく"
    },
    {
      "start": 47.3,
      "end": 49.98,
      "text": "I love... なんて"
    },
    {
      "start": 49.98,
      "end": 52.88,
      "text": "言いかけてはやめて"
    },
    {
      "start": 52.88,
      "end": 55.5,
      "text": "I love... I love..."
    },
    {
      "start": 55.5,
      "end": 60.25,
      "text": "何度も"
    },
    {
      "start": 60.25,
      "end": 63.19,
      "text": "高まる愛の中"
    },
    {
      "start": 63.19,
      "end": 67.16,
      "text": "変わる心情の中"
    },
    {
      "start": 67.16,
      "end": 72.03,
      "text": "燦然と輝く姿は"
    },
    {
      "start": 72.03,
      "end": 75.68,
      "text": "まるで水槽の中に"
    },
    {
      "start": 75.68,
      "end": 76.95,
      "text": "飛び込んで"
    },
    {
      "start": 76.95,
      "end": 80.78,
      "text": "溶けた絵の具みたいな"
    },
    {
      "start": 80.78,
      "end": 82.82,
      "text": "イレギュラー"
    },
    {
      "start": 82.82,
      "end": 85.6,
      "text": "ひとりじゃ何ひとつ"
    },
    {
      "start": 85.6,
      "end": 89.52,
      "text": "気づけなかっただろう"
    },
    {
      "start": 89.52,
      "end": 94.25,
      "text": "こんなに鮮やかな色彩に"
    },
    {
      "start": 94.25,
      "end": 97.27,
      "text": "普通の事だと"
    },
    {
      "start": 97.27,
      "end": 101.62,
      "text": "とぼける君に言いかけた"
    },
    {
      "start": 101.62,
      "end": 117.97,
      "text": "I love その続きを送らせて"
    },
    {
      "start": 117.97,
      "end": 121.71,
      "text": "見えないもの見て笑う"
    },
    {
      "start": 121.71,
      "end": 123.66,
      "text": "君のことを"
    },
    {
      "start": 123.66,
      "end": 127.27,
      "text": "分かれない僕がいる"
    },
    {
      "start": 127.27,
      "end": 130.89,
      "text": "美しすぎて"
    },
    {
      "start": 130.89,
      "end": 134.12,
      "text": "目が眩んでしまう"
    },
    {
      "start": 134.12,
      "end": 140.78,
      "text": "今も劣等感に縛られて 生きている"
    },
    {
      "start": 140.78,
      "end": 143.57,
      "text": "I love... I love..."
    },
    {
      "start": 143.57,
      "end": 146.5,
      "text": "不格好な結び目"
    },
    {
      "start": 146.5,
      "end": 149.16,
      "text": "I love... I love..."
    },
    {
      "start": 149.16,
      "end": 151.97,
      "text": "手探りで見つけて"
    },
    {
      "start": 151.97,
      "end": 154.53,
      "text": "I love your love"
    },
    {
      "start": 154.53,
      "end": 157.55,
      "text": "解いて 絡まって"
    },
    {
      "start": 157.55,
      "end": 161.92,
      "text": "僕は繰り返してる 何度も"
    },
    {
      "start": 161.92,
      "end": 165.09,
      "text": "レプリカばかりが"
    },
    {
      "start": 165.09,
      "end": 169.11,
      "text": "飾られた銀河"
    },
    {
      "start": 169.11,
      "end": 173.85,
      "text": "カーテンで作られた暗闇"
    },
    {
      "start": 173.85,
      "end": 176.87,
      "text": "嘆く人もいない"
    },
    {
      "start": 176.87,
      "end": 181.46,
      "text": "ねずみ色の街の中で"
    },
    {
      "start": 181.46,
      "end": 191.54,
      "text": "I love その証を抱きしめて"
    },
    {
      "start": 191.54,
      "end": 194.74,
      "text": "喜びも悲しみも"
    },
    {
      "start": 194.74,
      "end": 197.4,
      "text": "句読点の無い思いも"
    },
    {
      "start": 197.4,
      "end": 200.24,
      "text": "完全に分かち合うより"
    },
    {
      "start": 200.24,
      "end": 202.87,
      "text": "曖昧に悩みながらも"
    },
    {
      "start": 202.87,
      "end": 206.92,
      "text": "認め合えたなら"
    },
    {
      "start": 206.92,
      "end": 209.7,
      "text": "重なる愛の中"
    },
    {
      "start": 209.7,
      "end": 213.71,
      "text": "濁った感情の中"
    },
    {
      "start": 213.71,
      "end": 218.47,
      "text": "瞬きの僅かその合間に"
    },
    {
      "start": 218.47,
      "end": 222.93,
      "text": "君がくれたプレゼントは"
    },
    {
      "start": 222.93,
      "end": 227.32,
      "text": "このやけに優しい世界だ"
    },
    {
      "start": 227.32,
      "end": 229.15,
      "text": "イレギュラー"
    },
    {
      "start": 229.15,
      "end": 232.01,
      "text": "ひとりじゃ何ひとつ"
    },
    {
      "start": 232.01,
      "end": 236.06,
      "text": "気づけなかっただろう"
    },
    {
      "start": 236.06,
      "end": 241.01,
      "text": "こんなに大切な光に"
    },
    {
      "start": 241.01,
      "end": 243.68,
      "text": "普通の事だと"
    },
    {
      "start": 243.68,
      "end": 248.47,
      "text": "とぼける君に言いかけた"
    },
    {
      "start": 248.47,
      "end": 262.35,
      "text": "I love その続きを送らせて"
    },
    {
      "start": 262.35,
      "end": 265.67,
      "text": "受け取り合う僕ら"
    },
    {
      "start": 265.67,
      "end": 268.74,
      "text": "名前も無い夜が"
    },
    {
      "start": 268.74,
      "end": 275.61,
      "text": "老けていく"
    }
  ],
