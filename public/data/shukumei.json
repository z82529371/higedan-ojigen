{
  "id": "shukumei",
  "title": "宿命",
  "audio": "audio/shukumei.m4a",
  "lyrics": [
    {
      "start": 14.3,
      "end": 19.59,
      "text": "心臓からあふれ出した声で"
    },
    {
      "start": 19.59,
      "end": 22.57,
      "text": "歌うメロディ"
    },
    {
      "start": 22.57,
      "end": 26.28,
      "text": "振り向いた未来"
    },
    {
      "start": 26.28,
      "end": 31.32,
      "text": "君から あふれ出した声と"
    },
    {
      "start": 31.32,
      "end": 34.25,
      "text": "合わさって響いた"
    },
    {
      "start": 34.25,
      "end": 38.03,
      "text": "群青の空の下"
    },
    {
      "start": 38.03,
      "end": 40.33,
      "text": "夢じゃない 夢じゃない"
    },
    {
      "start": 40.33,
      "end": 43.99,
      "text": "涙の足跡"
    },
    {
      "start": 43.99,
      "end": 46.08,
      "text": "嘘じゃない 嘘じゃな"
    },
    {
      "start": 46.08,
      "end": 49.73,
      "text": "泥だらけの笑顔"
    },
    {
      "start": 49.73,
      "end": 52.62,
      "text": "夢じゃない 夢じゃない"
    },
    {
      "start": 52.62,
      "end": 55.46,
      "text": "肩を組んで叫びたい"
    },
    {
      "start": 55.46,
      "end": 61.46,
      "text": "僕らの想い 届け！"
    },
    {
      "start": 61.46,
      "end": 64.54,
      "text": "奇跡じゃなくていい"
    },
    {
      "start": 64.54,
      "end": 67.18,
      "text": "美しくなくていい"
    },
    {
      "start": 67.18,
      "end": 73.29,
      "text": "生きがいってやつが光輝くから"
    },
    {
      "start": 73.29,
      "end": 76.28,
      "text": "切れないバッテリー"
    },
    {
      "start": 76.28,
      "end": 78.73,
      "text": "魂の限り"
    },
    {
      "start": 78.73,
      "end": 84.37,
      "text": "宿命ってやつを燃やして"
    },
    {
      "start": 84.37,
      "end": 93.4,
      "text": "暴れ出すだけなんだ"
    },
    {
      "start": 93.4,
      "end": 98.53,
      "text": "沈黙が続いたイヤフォン"
    },
    {
      "start": 98.53,
      "end": 105.17,
      "text": "自分の弱さに遠ざかってく未来"
    },
    {
      "start": 105.17,
      "end": 110.27,
      "text": "「大丈夫」や「頑張れ」って歌詞に"
    },
    {
      "start": 110.27,
      "end": 113.28,
      "text": "苛立ってしまった"
    },
    {
      "start": 113.28,
      "end": 117.17,
      "text": "そんな夜もあった"
    },
    {
      "start": 117.17,
      "end": 119.42,
      "text": "夢じゃない 夢じゃない"
    },
    {
      "start": 119.42,
      "end": 123.09,
      "text": "あの日の悔しさと"
    },
    {
      "start": 123.09,
      "end": 128.83,
      "text": "忘れない 忘れない"
    },
    {
      "start": 128.83,
      "end": 134.57,
      "text": "掌の爪痕"
    },
    {
      "start": 134.57,
      "end": 140.31,
      "text": "無駄じゃない 無駄じゃない"
    },
    {
      "start": 140.31,
      "end": 146.05,
      "text": "それも全て讃えたい"
    },
    {
      "start": 146.05,
      "end": 151.78,
      "text": "もうあと少し"
    },
    {
      "start": 151.78,
      "end": 157.52,
      "text": "願いの熱さに"
    },
    {
      "start": 157.52,
      "end": 163.26,
      "text": "汗まみれになったり"
    },
    {
      "start": 163.26,
      "end": 169,
      "text": "期待背負って立って"
    },
    {
      "start": 169,
      "end": 174.74,
      "text": "重さに臆病になるけど"
    },
    {
      "start": 174.74,
      "end": 180.48,
      "text": "僕らの背番号"
    },
    {
      "start": 180.48,
      "end": 186.22,
      "text": "それは背中じゃなく"
    },
    {
      "start": 186.22,
      "end": 191.96,
      "text": "瞳の奥のアンサー"
    },
    {
      "start": 191.96,
      "end": 197.7,
      "text": "重なって 照らし合ってく Forever"
    },
    {
      "start": 197.7,
      "end": 203.44,
      "text": "緊張から不安が芽生えて"
    },
    {
      "start": 203.44,
      "end": 209.17,
      "text": "根を張るみたいに"
    },
    {
      "start": 209.17,
      "end": 214.91,
      "text": "僕らを支配する"
    },
    {
      "start": 214.91,
      "end": 220.65,
      "text": "そんなものに負けてたまるかと"
    },
    {
      "start": 220.65,
      "end": 226.39,
      "text": "今 宿命ってやつを燃やして"
    },
    {
      "start": 226.39,
      "end": 232.13,
      "text": "暴れ出す 届け！"
    },
    {
      "start": 232.13,
      "end": 237.87,
      "text": "奇跡じゃなくていい"
    },
    {
      "start": 237.87,
      "end": 243.61,
      "text": "美しくなくていい"
    },
    {
      "start": 243.61,
      "end": 249.35,
      "text": "生きがいってやつが光輝くから"
    },
    {
      "start": 249.35,
      "end": 255.09,
      "text": "切れないバッテリー 魂の限り"
    },
    {
      "start": 255.09,
      "end": 260.83,
      "text": "宿命ってやつを燃やして"
    },
    {
      "start": 260.83,
      "end": 266.56,
      "text": "暴れ出すだけなんだ"
    },
    {
      "start": 266.56,
      "end": 272.3,
      "text": "ただ宿命ってやつをかざして"
    },
    {
      "start": 272.3,
      "end": 278.04,
      "text": "立ち向かうだけなんだ"
    }
  ],
