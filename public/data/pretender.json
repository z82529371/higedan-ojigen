{
  "id": "pretender",
  "title": "Pretender",
  "audio": "audio/pretender.m4a",
  "lyrics": [
    {
      "start": 31.5,
      "end": 34.55,
      "text": "君とのラブストーリー"
    },
    {
      "start": 34.55,
      "end": 37.4,
      "text": "それは予想通り"
    },
    {
      "start": 37.4,
      "end": 41.66,
      "text": "いざ始まればひとり芝居だ"
    },
    {
      "start": 41.66,
      "end": 44.12,
      "text": "ずっとそばにいたって"
    },
    {
      "start": 44.12,
      "end": 47.22,
      "text": "結局ただの観客だ"
    },
    {
      "start": 47.22,
      "end": 50.44,
      "text": "感情のないアイムソーリー"
    },
    {
      "start": 50.44,
      "end": 52.98,
      "text": "それはいつも通り"
    },
    {
      "start": 52.98,
      "end": 57.45,
      "text": "慣れてしまえば悪くはないけど"
    },
    {
      "start": 57.45,
      "end": 60.92,
      "text": "君とのロマンスは人生柄"
    },
    {
      "start": 60.92,
      "end": 67.91,
      "text": "続きはしないことを知った"
    },
    {
      "start": 67.91,
      "end": 70.46,
      "text": "もっと違う設定で"
    },
    {
      "start": 70.46,
      "end": 73.05,
      "text": "もっと違う関係で"
    },
    {
      "start": 73.05,
      "end": 75.37,
      "text": "出会える世界線"
    },
    {
      "start": 75.37,
      "end": 78.33,
      "text": "選べたらよかった"
    },
    {
      "start": 78.33,
      "end": 80.83,
      "text": "もっと違う性格で"
    },
    {
      "start": 80.83,
      "end": 83.27,
      "text": "もっと違う価値観で"
    },
    {
      "start": 83.27,
      "end": 88.05,
      "text": "愛を伝えられたらいいな"
    },
    {
      "start": 88.05,
      "end": 93.33,
      "text": "そう願っても無駄だから"
    },
    {
      "start": 93.43,
      "end": 94.1,
      "text": "グッバイ"
    },
    {
      "start": 94.1,
      "end": 99.05,
      "text": "君の運命のヒトは僕じゃない"
    },
    {
      "start": 99.05,
      "end": 101.6,
      "text": "辛いけど否めない"
    },
    {
      "start": 101.6,
      "end": 105.3,
      "text": "でも離れ難いのさ"
    },
    {
      "start": 105.3,
      "end": 109.33,
      "text": "その髪に触れただけで"
    },
    {
      "start": 109.33,
      "end": 111.98,
      "text": "痛いや いやでも"
    },
    {
      "start": 111.98,
      "end": 114.18,
      "text": "甘いな いやいや"
    },
    {
      "start": 114.18,
      "end": 115.14,
      "text": "グッバイ"
    },
    {
      "start": 115.14,
      "end": 119.9,
      "text": "それじゃ僕にとって君は何？"
    },
    {
      "start": 119.9,
      "end": 122.37,
      "text": "答えは分からない"
    },
    {
      "start": 122.37,
      "end": 126.21,
      "text": "分かりたくもないのさ"
    },
    {
      "start": 126.21,
      "end": 133.78,
      "text": "たったひとつ確かなことがあるとするのならば"
    },
    {
      "start": 133.78,
      "end": 141.19,
      "text": "君は綺麗だ"
    },
    {
      "start": 141.19,
      "end": 144.34,
      "text": "誰かが偉そうに"
    },
    {
      "start": 144.34,
      "end": 146.95,
      "text": "語る恋愛の論理"
    },
    {
      "start": 146.95,
      "end": 151.23,
      "text": "何ひとつとしてピンとこなくて"
    },
    {
      "start": 151.23,
      "end": 154.74,
      "text": "飛行機の窓から見下ろした"
    },
    {
      "start": 154.74,
      "end": 161.71,
      "text": "知らない街の夜景みたいだ"
    },
    {
      "start": 161.71,
      "end": 164.13,
      "text": "もっと違う設定で"
    },
    {
      "start": 164.13,
      "end": 166.94,
      "text": "もっと違う関係で"
    },
    {
      "start": 166.94,
      "end": 169.34,
      "text": "出会える世界線"
    },
    {
      "start": 169.34,
      "end": 172.24,
      "text": "選べたらよかった"
    },
    {
      "start": 172.24,
      "end": 174.64,
      "text": "いたって純な心で"
    },
    {
      "start": 174.64,
      "end": 177.16,
      "text": "叶った恋を抱きしめて"
    },
    {
      "start": 177.16,
      "end": 182.01,
      "text": "好きだとか無責任に言えたらいいな"
    },
    {
      "start": 182.01,
      "end": 187.1,
      "text": "そう願っても虚しいのさ"
    },
    {
      "start": 187.1,
      "end": 188.03,
      "text": "グッバイ"
    },
    {
      "start": 188.03,
      "end": 192.98,
      "text": "繋いだ手の向こうにエンドライン"
    },
    {
      "start": 192.98,
      "end": 195.49,
      "text": "引き伸ばすたびに"
    },
    {
      "start": 195.49,
      "end": 199.18,
      "text": "疼きだす未来には"
    },
    {
      "start": 199.18,
      "end": 201.11,
      "text": "君はいない"
    },
    {
      "start": 201.11,
      "end": 206.89,
      "text": "その事実に Cry"
    },
    {
      "start": 206.89,
      "end": 213.03,
      "text": "そりゃ苦しいよな"
    },
    {
      "start": 228.9,
      "end": 229.89,
      "text": "グッバイ"
    },
    {
      "start": 229.89,
      "end": 234.66,
      "text": "君の運命のヒトは僕じゃない"
    },
    {
      "start": 234.66,
      "end": 237.14,
      "text": "辛いけど否めない"
    },
    {
      "start": 237.14,
      "end": 240.91,
      "text": "でも離れ難いのさ"
    },
    {
      "start": 240.91,
      "end": 245.21,
      "text": "その髪に触れただけで"
    },
    {
      "start": 245.21,
      "end": 247.63,
      "text": "痛いや いやでも"
    },
    {
      "start": 247.63,
      "end": 249.89,
      "text": "甘いな いやいや"
    },
    {
      "start": 249.89,
      "end": 250.69,
      "text": "グッバイ"
    },
    {
      "start": 250.69,
      "end": 255.41,
      "text": "それじゃ僕にとって君は何？"
    },
    {
      "start": 255.41,
      "end": 257.97,
      "text": "答えは分からない"
    },
    {
      "start": 257.97,
      "end": 261.83,
      "text": "分かりたくもないのさ"
    },
    {
      "start": 261.83,
      "end": 269.7,
      "text": "たったひとつ確かなことがあるとするのならば"
    },
    {
      "start": 269.7,
      "end": 271.73,
      "text": "君は綺麗だ"
    },
    {
      "start": 271.73,
      "end": 280.16,
      "text": "それもこれもロマンスの定めなら"
    },
    {
      "start": 280.16,
      "end": 282.4,
      "text": "悪くないよな"
    },
    {
      "start": 282.4,
      "end": 290.53,
      "text": "永遠も約束もないけれど"
    },
    {
      "start": 290.53,
      "end": 305.87,
      "text": "とても綺麗だ"
    }
  ],
