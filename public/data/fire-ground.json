    {
      "start": 17.7,
      "end": 21.8,
      "text": "1つとしてアドバンテージなんてない"
    },
    {
      "start": 21.8,
      "end": 23.76,
      "text": "「向いてない」「センスない」"
    },
    {
      "start": 23.76,
      "end": 26.06,
      "text": "誰もがそう言って笑ってる"
    },
    {
      "start": 26.06,
      "end": 29.69,
      "text": "なんて事ないビビる必要はない"
    },
    {
      "start": 29.69,
      "end": 31.94,
      "text": "結果1発で180度"
    },
    {
      "start": 31.94,
      "end": 34.23,
      "text": "真っ白な歓声に変わるぞ"
    },
    {
      "start": 34.23,
      "end": 38.13,
      "text": "アイデンティティのイス取りゲームは"
